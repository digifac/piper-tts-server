# piper-tts-server configuration (all variables are optional; defaults shown)

# Inference device: auto | cpu | cuda   (default: auto — uses CUDA if available)
TTS_DEVICE=auto

# Directory where voice models (.onnx + .json) are cached on disk.
# Mount a persistent volume here in Kubernetes so downloads survive restarts.
TTS_VOICE_CACHE_DIR=./voices

# In-memory LRU cache size for loaded PiperVoice models (default: 4)
TTS_MAX_LOADED_VOICES=4

# HTTP server bind address and port (defaults shown)
TTS_HOST=0.0.0.0
TTS_PORT=8000

# Optional HuggingFace token, only needed if a voice repo requires authentication.
# TTS_HF_TOKEN=

# TTL in seconds for the cached voice listing fetched from HuggingFace (default: 3600)
# TTS_VOICES_LIST_TTL_SECONDS=3600
